    "android:release": "node scripts/android-release.mjs",
    "android:release:apk": "node scripts/android-release.mjs --apk",
    "android:release:aab": "node scripts/android-release.mjs --aab",
    "macos:dev": "tauri macos run dev",
    "macos:release": "tauri macos build --release"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "^5.24.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
