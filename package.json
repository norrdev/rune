{
  "name": "runestonesafari",
  "version": "2.3.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:build": "cd android && ./gradlew assembleRelease",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "emulator": "emulator -avd $(emulator -list-avds | head -n 1)",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "deploy": "npx expo export --platform web && npx wrangler deploy"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.9",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.93.1",
    "expo": "~55.0.15",
    "expo-constants": "^55.0.14",
    "expo-linking": "^55.0.13",
    "expo-router": "~55.0.12",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "idb": "^8.0.3",
    "lucide-react": "^1.8.0",
    "lucide-react-native": "^1.8.0",
    "maplibre-gl": "^5.23.0",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "nativewind": "^4.2.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "^10.1.0",
    "react-native": "0.85.1",
    "react-native-css-interop": "^0.2.3",
    "react-native-reanimated": "~4.3.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "~4.24.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets-core": "^1.6.3",
    "tailwindcss": "^3.4.19"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.2.14",
    "babel-preset-expo": "^55.0.17",
    "typescript": "~6.0.3",
    "wrangler": "^4.83.0"
  }
}
